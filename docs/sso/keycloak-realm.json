{
	"realm": "kuayle",
	"enabled": true,
	"displayName": "Kuayle development",
	"registrationAllowed": false,
	"loginWithEmailAllowed": true,
	"duplicateEmailsAllowed": false,
	"resetPasswordAllowed": false,
	"editUsernameAllowed": false,
	"clients": [
		{
			"clientId": "kuayle",
			"name": "Kuayle",
			"enabled": true,
			"protocol": "openid-connect",
			"publicClient": false,
			"secret": "kuayle-dev-client-secret",
			"standardFlowEnabled": true,
			"implicitFlowEnabled": false,
			"directAccessGrantsEnabled": false,
			"serviceAccountsEnabled": false,
			"redirectUris": [
				"http://localhost:5173/api/auth/sso/*",
				"http://localhost:8080/api/auth/sso/*"
			],
			"webOrigins": ["http://localhost:5173", "http://localhost:8080"],
			"attributes": {
				"pkce.code.challenge.method": "S256",
				"post.logout.redirect.uris": "+"
			}
		},
		{
			"clientId": "http://localhost:5173/api/auth/sso/acme/metadata",
			"name": "Kuayle SAML (acme)",
			"enabled": true,
			"protocol": "saml",
			"redirectUris": [
				"http://localhost:5173/api/auth/sso/acme/callback"
			],
			"attributes": {
				"saml.assertion.signature": "true",
				"saml.authnstatement": "true",
				"saml.server.signature": "false",
				"saml.client.signature": "false",
				"saml.signature.algorithm": "RSA_SHA256",
				"saml_name_id_format": "persistent",
				"saml_force_name_id_format": "true"
			},
			"protocolMappers": [
				{
					"name": "email",
					"protocol": "saml",
					"protocolMapper": "saml-user-property-mapper",
					"config": {
						"user.attribute": "email",
						"attribute.name": "email",
						"attribute.nameformat": "Basic"
					}
				},
				{
					"name": "emailVerified",
					"protocol": "saml",
					"protocolMapper": "saml-user-property-mapper",
					"config": {
						"user.attribute": "emailVerified",
						"attribute.name": "email_verified",
						"attribute.nameformat": "Basic"
					}
				}
			]
		}
	],
	"users": [
		{
			"username": "demo",
			"enabled": true,
			"emailVerified": true,
			"email": "demo@example.com",
			"firstName": "Demo",
			"lastName": "User",
			"credentials": [
				{
					"type": "password",
					"value": "demo",
					"temporary": false
				}
			]
		}
	]
}
