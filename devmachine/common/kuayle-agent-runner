#!/bin/sh
set -eu

attempt=0
while [ ! -f /run/kuayle-secrets/.ready ]; do
  attempt=$((attempt + 1))
  if [ "$attempt" -ge 300 ]; then
    echo "timed out waiting for scoped agent secrets" >&2
    exit 1
  fi
  sleep 0.1
done

old_ifs=$IFS
IFS=,
for secret_name in ${KUAYLE_SECRET_NAMES:-}; do
  case "$secret_name" in
    ''|*[!A-Za-z0-9_]*) echo "invalid secret name" >&2; exit 1 ;;
  esac
  secret_file="/run/kuayle-secrets/$secret_name"
  if [ -f "$secret_file" ]; then
    secret_value=$(cat "$secret_file"; printf x)
    secret_value=${secret_value%x}
    export "$secret_name=$secret_value"
    rm -f "$secret_file"
  fi
done
IFS=$old_ifs
rm -f /run/kuayle-secrets/.ready

# BEGIN KUAYLE DEEPSEEK CODEX CONFIG
configure_deepseek_codex() {
  [ -n "${DEEPSEEK_API_KEY:-}" ] || return 0
  [ -n "${KUAYLE_DEEPSEEK_MODEL:-}" ] || return 0
  case "${KUAYLE_DEEPSEEK_MODEL}" in
    deepseek-flash|deepseek-v4-pro) ;;
    *) echo "invalid DeepSeek model" >&2; return 1 ;;
  esac
  case "${KUAYLE_DEEPSEEK_THINKING:-}" in
    off) effort=none ;;
    low|high|max) effort=${KUAYLE_DEEPSEEK_THINKING} ;;
    *) echo "invalid DeepSeek thinking level" >&2; return 1 ;;
  esac
  codex_config=${HOME:?}/.codex/config.toml
  [ ! -e "$codex_config" ] || return 0
  mkdir -p "${codex_config%/*}"
  old_umask=$(umask)
  umask 077
  if [ ! -e "$codex_config" ]; then
    cat > "$codex_config" <<EOF
model = "${KUAYLE_DEEPSEEK_MODEL}"
model_provider = "deepseek"
model_reasoning_effort = "${effort}"

[model_providers.deepseek]
name = "DeepSeek"
base_url = "https://api.deepseek.com"
env_key = "DEEPSEEK_API_KEY"
wire_api = "responses"
EOF
  fi
  umask "$old_umask"
}
configure_deepseek_codex
# END KUAYLE DEEPSEEK CODEX CONFIG

home_dir=${HOME:-/home/kuayle}
credential_helper=${KUAYLE_GIT_CREDENTIAL_HELPER:-$home_dir/.kuayle-git-credential}
case "$credential_helper" in /* ) ;; * ) echo "invalid credential helper path" >&2; exit 1 ;; esac
helper_dir=${credential_helper%/*}
mkdir -p "$helper_dir"
old_umask=$(umask)
umask 077
cat > "$credential_helper" <<'SCRIPT'
#!/bin/sh
case "${1:-get}" in
  get ) ;;
  store|erase ) exit 0 ;;
  * ) exit 0 ;;
esac
if [ -z "${GITHUB_TOKEN:-}" ]; then
  echo "missing active GitHub token" >&2
  exit 1
fi
printf '%s\n' username=x-access-token
printf '%s\n' "password=$GITHUB_TOKEN"
SCRIPT
chmod 0700 "$credential_helper"
umask "$old_umask"
git config --global --unset-all core.askPass >/dev/null 2>&1 || true
git config --global --unset-all credential.helper >/dev/null 2>&1 || true
git config --global credential.helper "$credential_helper"
export GIT_TERMINAL_PROMPT=0

exec "$@"
