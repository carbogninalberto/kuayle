DATABASE_URL=postgres://kuayle:kuayle@localhost:5432/kuayle?sslmode=disable
REDIS_URL=redis://localhost:6379
JWT_SECRET=local_dev_jwt_secret_32_chars_minimum_do_not_use_prod
PORT=8080
# Exact frontend origin (scheme + host + optional port). Dev Machine native
# terminal WebSockets require their Origin to match this value exactly.
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
# Seeded Alice. Demo mode uses SYSADMINS as the allowlist for Dev Machines.
SYSADMINS=a0000000-0000-0000-0000-000000000001

# Frontend demo mode (shows demo login users on /login when enabled).
# When this is true only users listed in SYSADMINS may create or use
# Dev Machines; all other authenticated users receive 403 on every
# Dev Machine API route, and the machine gateway rejects non-sysadmin
# ticket exchanges and sessions.
PUBLIC_DEMO_MODE=true
# With no override, the UI exposes all five users created by `make seed`.
# PUBLIC_DEMO_USERS='[{"label":"Owner","email":"alice@kuayle.dev","password":"Password123!"}]'

# When true, POST /api/auth/register returns 403 unless the request carries a
# valid workspace invite-link token. Default false keeps registration open.
# DISABLE_REGISTRATION=true

# Storage (default: local filesystem)
# STORAGE_TYPE=local
# STORAGE_LOCAL_DIR=./uploads
# STORAGE_LOCAL_URL=/uploads

# S3-compatible storage (SeaweedFS, AWS S3, Cloudflare R2)
# STORAGE_TYPE=s3
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_BUCKET=kuayle-uploads
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC=true
# S3_CDN_BASE_URL=

# GitHub App (SaaS mode — shared app across all workspaces)
# When set, skips per-workspace manifest setup. Each workspace only needs to install the app.
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_PRIVATE_KEY=        # base64-encoded PEM: cat private-key.pem | base64
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_WEBHOOK_SECRET=

# GitHub webhook URL (optional — for dev with smee.io or private networks)
# GITHUB_WEBHOOK_URL=

# Dev Machines local development. `make dev-start-services` builds the runtime
# images, provisions the restricted local gateway role, and starts the manager,
# gateway, and Caddy wildcard TLS proxy for https://*.machines.localhost.
# The dev proxy binds 127.0.0.1:80 and 127.0.0.1:443, so stop the selfhosting
# stack first if it is already using those ports. The browser must trust
# Caddy's local CA for warning-free wildcard TLS launches.
# The machine domain must be a separate registrable domain, not a sibling
# subdomain of the main app. machines.localhost is the local-development
# exception. Production requires wildcard TLS via DNS-01 Caddy or a mounted cert.
# FRONTEND_URL must be the exact public frontend origin for native terminal WS.
# Workspace policy controls maximum hard runtime and idle pause; default idle
# pause is 240 minutes, keep_running=true bypasses idle pause, and no automatic
# deletion is performed.
# Workspace disk limits require Docker's data root on XFS mounted with pquota or
# prjquota. The manager fails startup when local-volume hard quotas are unavailable.
DEV_MACHINES_ENABLED=true
DEV_MACHINE_DOMAIN=machines.localhost
DEV_MACHINE_ENCRYPTION_KEY=local_dev_machine_encryption_key_32_chars_minimum
# Local placeholder required by manager validation. Collector delivery needs an
# HTTPS URL reachable from machine containers; use an HTTPS tunnel/public dev URL
# if you need collector telemetry while running the backend directly on the host.
DEV_MACHINE_INGEST_URL=https://kuayle.localhost/api/dev-machine-ingest
DEV_MACHINE_SESSION_TTL_MINUTES=480
DEV_MACHINE_ACCESS_TICKET_TTL_SECONDS=60
DEV_MACHINE_GATEWAY_CONTAINER=kuayle-dev-machine-gateway
# Clearly local restricted gateway role defaults. Do not reuse in production.
DEV_MACHINE_GATEWAY_DB_USER=kuayle_gateway_dev
DEV_MACHINE_GATEWAY_DB_PASSWORD=local_dev_gateway_password_do_not_use_prod
# DEV_MACHINE_GATEWAY_DATABASE_URL=postgres://kuayle_gateway_dev:local_dev_gateway_password_do_not_use_prod@postgres:5432/kuayle?sslmode=disable
DEV_MACHINE_PULL_IMAGES=false
# `make dev-start-services` computes the daemon socket's numeric group at
# runtime for Colima/Linux. Set it manually when running Compose directly.
DEV_MACHINE_DOCKER_GID=0
DEV_MACHINE_DOCKER_HOST=unix:///var/run/docker.sock
DEV_MACHINE_SECCOMP_PROFILE=
DEV_MACHINE_APPARMOR_PROFILE=
DEV_MACHINE_EGRESS_ALLOWLIST=
DEV_MACHINE_EGRESS_DENYLIST=
# Local runtime image tags built by `make dev-start-services`. The developer
# image includes code-server, ttyd, tmux, and pinned OpenCode/Claude Code/Codex
# CLIs; provider agent images are pinned separately.
DEV_MACHINE_IDE_IMAGE=kuayle/dev-machine-ide:dev
DEV_MACHINE_BROWSER_IMAGE=kuayle/dev-machine-browser:dev
DEV_MACHINE_COLLECTOR_IMAGE=kuayle/dev-machine-collector:dev
DEV_MACHINE_EGRESS_IMAGE=kuayle/dev-machine-egress:dev
DEV_MACHINE_CLAUDE_IMAGE=kuayle/dev-machine-agent-claude:dev
DEV_MACHINE_OPENCODE_IMAGE=kuayle/dev-machine-agent-opencode:dev
DEV_MACHINE_CODEX_IMAGE=kuayle/dev-machine-agent-codex:dev
